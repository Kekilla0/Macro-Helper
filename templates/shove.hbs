{{!-- Shove : for each target that failed, the shover picks Prone or a 5 ft push. Context from maneuvers.js cardSection :
      { rows : [{ uuid, name, done, prone, push }] } --}}
<div class="macro-helper-shove">
    {{#each rows}}
    <section class="icon-row">
        <i class="fa-fw fa-solid fa-hand" inert></i>
        <span class="name">{{ name }}</span>
        <div class="card-buttons">
            <button type="button" data-action="cardButton" data-id="shove" data-target="{{ uuid }}" data-choice="prone" {{ disabled done }}>
                <i class="fa-solid {{#if prone}}fa-check{{else}}fa-person-falling{{/if}}" inert></i>
                <span>{{ localize "rollItem.maneuver.prone" }}</span>
            </button>
            <button type="button" data-action="cardButton" data-id="shove" data-target="{{ uuid }}" data-choice="push" {{ disabled done }}>
                <i class="fa-solid {{#if push}}fa-check{{else}}fa-arrow-right{{/if}}" inert></i>
                <span>{{ localize "rollItem.maneuver.push" }}</span>
            </button>
        </div>
    </section>
    {{/each}}
</div>
