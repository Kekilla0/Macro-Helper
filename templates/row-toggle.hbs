{{!-- A save card's per-target toggles (row-toggles.js, saveRowToggle : Careful / Heightened Spell) : { id, label, icon, hint, rows : [{ uuid, name, on, disabled }] } --}}
<div class="macro-helper-row-toggle">
    <section class="icon-row ray-header">
        <i class="fa-fw fa-solid {{ icon }}" inert></i>
        <span class="roboto-upper">{{ label }}</span>
    </section>
    <p class="hint">{{ hint }}</p>
    <div class="card-buttons">
        {{#each rows}}
        <button type="button" data-action="cardButton" data-id="toggle|{{ ../id }}" data-target="{{ uuid }}" {{ disabled disabled }}>
            <i class="fa-solid {{#if on}}fa-square-check{{else}}fa-square{{/if}}" inert></i>
            <span>{{ name }}</span>
        </button>
        {{/each}}
    </div>
</div>
