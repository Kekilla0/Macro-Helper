{{!-- What item macros add to one attack (stage hooks), context from message.js extrasContext :
      { ray, hasRay, extras : [{ key, label, damage, chosen }], buttons : [{ id, label, icon }] } --}}
<div class="macro-helper-extras">
    {{#each extras}}
    <section class="icon-row ray-header">
        <i class="fa-fw fa-solid fa-plus" inert></i>
        <span class="roboto-upper">{{ label }}{{#if chosen}} <i class="fa-solid fa-check" inert></i>{{/if}}</span>
    </section>
    {{#with damage}}{{> "macro-helper.damage-rows" }}{{/with}}
    {{#if damage.showTray}}
    <macro-helper-damage class="dnd5e2" data-part="extra" data-key="{{ key }}" {{#if ../hasRay}}data-ray="{{ ../ray }}"{{/if}}></macro-helper-damage>
    {{/if}}
    {{/each}}

    {{#each notes}}
    <section class="icon-row macro-helper-card-note" {{#if tooltip}}data-tooltip="{{ tooltip }}"{{/if}}>
        <i class="fa-fw fa-solid {{#if icon}}{{ icon }}{{else}}fa-circle-info{{/if}}" inert></i>
        <span>{{ text }}</span>
    </section>
    {{/each}}

    {{#if buttons.length}}
    <div class="card-buttons">
        {{#each buttons}}
        <button type="button" data-action="cardButton" data-id="{{ id }}" data-ray="{{ ../ray }}" {{#if tooltip}}data-tooltip="{{ tooltip }}"{{/if}}>
            <i class="fa-solid {{#if icon}}{{ icon }}{{else}}fa-star{{/if}}" inert></i>
            <span>{{ label }}</span>
        </button>
        {{/each}}
    </div>
    {{/if}}
</div>
