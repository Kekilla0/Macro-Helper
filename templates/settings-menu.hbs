{{!-- One page of settings, context from settings-menu.js : settings [{ key, id, name, hint, value, isBoolean, choices, world, disabled,
     off (why it's greyed), homebrew, section (a heading above it) }] --}}
{{#*inline "setting"}}
    {{#if section}}<h3 class="border">{{ localize section }}</h3>{{/if}}
    <div class="form-group{{#if off}} macro-helper-setting-off{{/if}}">
        <label for="{{ id }}">{{ localize name }}{{#if homebrew}} <span class="macro-helper-homebrew-tag">{{ localize "settings.menu.homebrew" }}</span>{{/if}}</label>
        <div class="form-fields">
            {{#if isBoolean}}
            <input type="checkbox" id="{{ id }}" name="{{ key }}" {{ checked value }} {{ disabled disabled }}>
            {{else if choices}}
            <select id="{{ id }}" name="{{ key }}" {{ disabled disabled }}>
                {{ selectOptions choices selected=value localize=true }}
            </select>
            {{else}}
            <input type="text" id="{{ id }}" name="{{ key }}" value="{{ value }}" {{ disabled disabled }}>
            {{/if}}
        </div>
        {{#if off}}<p class="hint"><em>{{ off }}</em></p>{{/if}}
        {{#if hint}}
        <p class="hint">
            {{ localize hint }}
            {{#unless world}}<em>{{ localize "settings.menu.client" }}</em>{{/unless}}
        </p>
        {{else unless world}}
        <p class="hint"><em>{{ localize "settings.menu.client" }}</em></p>
        {{/if}}
    </div>
{{/inline}}
<section class="macro-helper-settings-list">
    {{#each settings}}{{> setting}}{{/each}}
    {{#if server.length}}
    <h3 class="border">{{ localize "settings.player.server" }}</h3>
    <div class="macro-helper-server-buttons">
        {{#each server}}
        <button type="button" data-submenu="{{ key }}"><i class="{{ icon }}" inert></i> {{ localize label }}</button>
        {{/each}}
    </div>
    {{/if}}
    {{#if empty}}<p class="hint">{{ localize "settings.menu.empty" }}</p>{{/if}}
</section>
