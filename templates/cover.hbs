{{!-- Cover, GM only : a row per target like every card's rows (picture, name), its four levels on the right : none /
     half (+2) / three-quarters (+5) / total. Context : cover from message.js coverContext. --}}
{{#with cover}}
<ul class="unlist macro-helper-rows macro-helper-cover">
    {{#each targets}}
    <li class="macro-helper-row">
        <img class="token" src="{{ img }}" alt="" data-token="{{ uuid }}">
        <span class="name">{{ name }}</span>
        <span class="macro-helper-row-apply">
            <i class="fa-fw fa-solid fa-shield-halved" data-tooltip="{{ localize "cover.title" }}" aria-label="{{ localize "cover.title" }}"></i>
            {{#each levels}}
            <button type="button" class="{{#if active}}active{{/if}}" data-action="setCover" data-target="{{ ../uuid }}" data-level="{{ id }}"
                    data-tooltip="{{ tooltip }}" aria-label="{{ tooltip }}">{{ label }}</button>
            {{/each}}
        </span>
    </li>
    {{/each}}
</ul>
{{/with}}
